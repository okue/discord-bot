{
  "name": "discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --include-env=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply discord-bot --local",
    "db:migrate:remote": "wrangler d1 migrations apply discord-bot --remote"
  },
  "dependencies": {
    "discord-api-types": "^0.38.55",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
